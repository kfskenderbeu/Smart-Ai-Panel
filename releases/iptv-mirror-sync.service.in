[Unit]
Description=IPTV Panel mirror sync (ships live DB snapshot from active main)
After=network-online.target iptv-panel.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=@PATH_SCRIPT@
Environment=IPTV_PANEL_DIR=@DIR@
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
